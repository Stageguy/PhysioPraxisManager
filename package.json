{
  "name": "physio-praxis-manager",
  "version": "0.34.0",
  "description": "Praxis Lilli Nebel: Exchange (Mail, Kalender) und OneDrive über MS Graph",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:migrieren": "node --env-file-if-exists=.env src/cli/db-migrieren.ts",
    "entwurf": "node --env-file-if-exists=.env src/cli/entwurf.ts",
    "finanzjahr": "node --env-file-if-exists=.env src/cli/finanzjahr.ts",
    "hilfe:vorschau": "node src/cli/hilfe-vorschau.ts",
    "kategorien": "node --env-file-if-exists=.env src/cli/kategorien.ts",
    "login": "node --env-file-if-exists=.env src/cli/login.ts",
    "onedrive:ordner": "node --env-file-if-exists=.env src/cli/onedrive-ordner.ts",
    "pruefen": "node --env-file-if-exists=.env src/cli/verbindung-pruefen.ts",
    "rechnungen": "node --env-file-if-exists=.env src/cli/rechnungen.ts",
    "rechnungen:uebernahme": "node --env-file-if-exists=.env src/cli/rechnungen-uebernahme.ts",
    "rechnungen:zaehlen": "node --env-file-if-exists=.env src/cli/rechnungen-zaehlen.ts",
    "serve": "node --env-file-if-exists=.env src/cli/serve.ts",
    "termin": "node --env-file-if-exists=.env src/cli/termin.ts",
    "test": "node --test test/*.test.ts",
    "testordner": "node --env-file-if-exists=.env src/cli/testordner.ts",
    "typecheck": "tsc --noEmit",
    "zahlungen": "node --env-file-if-exists=.env src/cli/zahlungen.ts",
    "rechnungen:nachlesen": "node --env-file-if-exists=.env src/cli/rechnungen-nachlesen.ts",
    "preisquellen": "node --env-file-if-exists=.env src/cli/preisquellen.ts",
    "tresor:schluessel": "node src/cli/tresor-schluessel.ts",
    "testdaten": "node --env-file-if-exists=.env src/cli/testdaten.ts",
    "termine:abgleich": "node --env-file-if-exists=.env src/cli/termine-abgleich.ts",
    "anfragen": "node --env-file-if-exists=.env src/cli/anfragen.ts",
    "buchung": "node --env-file-if-exists=.env src/cli/buchung-serve.ts",
    "lexware:pruefen": "node --env-file-if-exists=.env src/cli/lexware-pruefen.ts",
    "lexware:kunden": "node --env-file-if-exists=.env src/cli/lexware-kunden.ts",
    "lexware:rechnungen": "node --env-file-if-exists=.env src/cli/lexware-rechnungen.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^6.0.1",
    "html2canvas": "^1.4.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^7.0.2"
  }
}

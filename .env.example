# Aus scripts/register-app.sh
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# Das einzige Konto, das sich anmelden darf – login.ts lehnt jedes andere ab
GRAPH_KONTO=praxis@lilli-nebel.de

# Lokales Datenverzeichnis (Token-Cache)
DATA_DIR=.data

# ── Praxisdienst (docker compose) ──
# Wer die Statusseite sehen darf: Tailnet-Konten, durch Komma getrennt
ERLAUBTE_NUTZER=
# Schlüssel aus dem Praxis-Tailnet (Admin-Konsole → Settings → Keys), mit Tag tag:praxis-dienst
TS_AUTHKEY=
# Wo token-cache.json liegt (Standard ./.data) und unter welcher Benutzer-ID der Dienst läuft
DATA_PFAD=./.data
APP_UID=1000
APP_GID=1000

# ── Datenbank (PostgreSQL, Quelle der Wahrheit) ──
# Nötig für `npm run rechnungen -- --ausfuehren`; im Probelauf optional (dann ohne Dublettenprüfung)
DATABASE_URL=

# ── Lexware Office (ab Tarif XL) ──
# API-Schlüssel des technischen Benutzers „Praxis-Automation“ (Einstellungen → Öffentliche API).
# Ohne Schlüssel läuft der Zahlungsabgleich über Outlook (Lilli setzt „Rechnung: bezahlt“ selbst).
LEXWARE_API_KEY=

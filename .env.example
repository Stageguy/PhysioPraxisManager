# Aus scripts/register-app.sh
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=

# Das einzige Konto, das sich anmelden darf – login.ts lehnt jedes andere ab
GRAPH_KONTO=praxis@lilli-nebel.de

# Lokales Datenverzeichnis (Token-Cache)
DATA_DIR=.data

# ── Praxisdienst (docker compose) ──
# Wer die Statusseite sehen darf: Tailnet-Konten, durch Komma getrennt
ERLAUBTE_NUTZER=
# Schlüssel aus dem Praxis-Tailnet (Admin-Konsole → Settings → Keys), mit Tag tag:praxis-dienst
TS_AUTHKEY=
# Wo token-cache.json liegt (Standard ./.data) und unter welcher Benutzer-ID der Dienst läuft
DATA_PFAD=./.data
APP_UID=1000
APP_GID=1000

# ── Datenbank (PostgreSQL, Quelle der Wahrheit) ──
# Nötig für `npm run rechnungen -- --ausfuehren`; im Probelauf optional (dann ohne Dublettenprüfung)
DATABASE_URL=

# Adresse der Praxis-Assistenz im Tailnet – für Links in Kalendereinträgen (setzt deploy/strato-dev.sh)
PRAXIS_URL=

# ── Patienten-Tresor (requirements §4a, §4b) ──
# Hauptschlüssel, mit dem die App Gesundheitsdaten verschlüsselt, bevor sie in die Datenbank gehen.
# Erzeugen: npm run tresor:schluessel · je Umgebung ein eigener · Notfallkopie offline bei Lilli.
# Form „<Nummer>:<base64>“; bei einem Schlüsselwechsel bekommt der neue die nächste Nummer.
PRAXIS_TRESOR_SCHLUESSEL=

# ── Lexware Office (ab Tarif XL) ──
# API-Schlüssel des technischen Benutzers „Praxis-Automation“ (Einstellungen → Öffentliche API).
# Ohne Schlüssel läuft der Zahlungsabgleich über Outlook (Lilli setzt „Rechnung: bezahlt“ selbst).
# Den Schlüssel liest nur die Produktion (deploy/strato-dev.sh prod); die Testumgebung bekommt stattdessen
# LEXWARE_ATTRAPPE=1 – erfundene Kunden unter Patienten › „Aus Lexware“ (W99).
LEXWARE_API_KEY=

# ── Umgebung (requirements N28) ──
# test = Testumgebung (erfundene Patienten, harte Schranken); leer = Produktion. Setzt deploy/strato-dev.sh.
PRAXIS_UMGEBUNG=
# Testadressen der erfundenen Patienten, durch Komma getrennt – auch die Produktion braucht sie (sie ignoriert diese Absender)
TEST_ADRESSEN=

# ── Praxis (W89: für eine zweite Praxis ohne Codeänderung) ──
# Name der Praxis in Nachrichten und PDFs (Standard „Praxis Lilli Nebel“), Telefon für „bitte rufen Sie zurück unter …“
PRAXIS_NAME=
PRAXIS_TELEFON=

# ── WhatsApp (W90) ──
# Ohne Zugangsdaten nur Click-to-Chat (wa.me-Links, Senden vom Handy). Mit Zugangsdaten der WhatsApp Business Platform
# sendet die Praxis-Assistenz selbst (nur mit Einwilligung des Patienten) und empfängt Antworten über /whatsapp/webhook.
WHATSAPP_TOKEN=
WHATSAPP_TELEFON_ID=
# App-Secret für die Signaturprüfung des Webhooks und frei gewähltes Verify-Token für die Einrichtung bei Meta
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Schranke 8: in der Testumgebung geht WhatsApp nur an diese Nummern (durch Komma getrennt)
TEST_TELEFONE=

# ── Terminanfragen (A15) ──
# Der Dienst liest den Ordner „Posteingang/Terminanfragen“ alle n Minuten (Standard 10, 0 = aus)
ANFRAGEN_TAKT_MIN=

# ── Buchungsseite (W96) ──
# Eigener Dienst (npm run buchung): BUCHUNG_PORT (3310), BUCHUNG_SCHLUESSEL (gemeinsam mit dem Manager – setzt deploy/strato-dev.sh),
# BUCHUNG_DATENSCHUTZ_URL (Link im Formular). Der Manager braucht BUCHUNG_URL (intern) und BUCHUNG_OEFFENTLICHE_URL (für die Schnipsel).
BUCHUNG_PORT=
BUCHUNG_SCHLUESSEL=
BUCHUNG_DATENSCHUTZ_URL=https://lilli-nebel.de/nachweise.html#datenschutz
BUCHUNG_URL=
BUCHUNG_OEFFENTLICHE_URL=
